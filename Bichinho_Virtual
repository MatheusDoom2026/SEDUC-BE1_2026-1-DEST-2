BichinhoVirtual

public class BichinhoVirtual {
    private String nome;
    private int fome;
    private int energia;

    public BichinhoVirtual(String nome) {
        this.nome = nome;
        this.fome = 50;
        this.energia = 50;
    }

    public String getNome() {
        return nome;
    }

    public int getFome() {
        return fome;
    }

    public int getEnergia() {
        return energia;
    }

    public String getHumor() {
        if (fome >= 70 && energia >= 70) {
            return "Muito feliz";
        } else if (fome >= 40 && energia >= 40) {
            return "Feliz";
        } else if (fome < 30 || energia < 30) {
            return "Triste";
        } else {
            return "Normal";
        }
    }

    public void alimentar(int quantidade) {
        if (quantidade <= 0) {
            return;
        }

        fome -= quantidade;

        if (fome < 0) {
            fome = 0;
        }
    }

    public void brincar(int quantidade) {
        if (quantidade <= 0) {
            return;
        }

        energia -= quantidade;

        if (energia < 0) {
            energia = 0;
        }

        fome += quantidade;

        if (fome > 100) {
            fome = 100;
        }
    }

    public void descansar(int quantidade) {
        if (quantidade <= 0) {
            return;
        }

        energia += quantidade;

        if (energia > 100) {
            energia = 100;
        }
    }
}
